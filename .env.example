# Backend (Railway) environment — set these in Railway > Variables
NODE_ENV=production
PORT=4000
API_PREFIX=/api

# PostgreSQL / Neon connection string
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Generate with: openssl rand -base64 32 (min 32 chars each)
JWT_SECRET=change-me-min-32-chars-production-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-min-32-chars-production-refresh
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=change-me-min-32-chars-production-session
SESSION_MAX_AGE=604800000

UPLOAD_DIR=./uploads
# Production on Railway: attach a Volume mounted at /app/uploads and set
# UPLOAD_DIR=/app/uploads, otherwise uploaded files are lost on every deploy
# (Railway container storage is ephemeral).
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,image/jpeg,image/png,application/zip

# Must be the Vercel frontend URL(s), comma-separated if more than one.
# The deployed frontend is https://dashboard-frontend-iota-indol.vercel.app
CORS_ORIGIN=https://dashboard-frontend-iota-indol.vercel.app
APP_URL=https://dashboard-frontend-iota-indol.vercel.app

# Outgoing email for notification mirroring (optional — skipped when unset).
# Gmail example: host smtp.gmail.com, port 587, user your Gmail address,
# pass an App Password (Google Account > Security > 2-Step Verification >
# App passwords). MAIL_FROM is the no-reply sender shown to recipients.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Doan Tan Hung (no-reply)" <no-reply@tanhung.vn>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
BCRYPT_ROUNDS=12
